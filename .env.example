# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth (Auth.js infers these names)
# Create a Web client in Google Cloud Console.
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-VERCEL-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Canonical site URL (local or Vercel)
AUTH_URL=http://localhost:3000

# Postgres — required to persist Played flags. Browse/search works without it.
# Neon, Supabase, or any Postgres URL is fine.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/madison_fairways?sslmode=require"
